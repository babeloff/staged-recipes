+clang_interpreter::clang_interpreter(std::unique_ptr<clang::Interpreter> native,
+                                    std::shared_ptr<jit_state> state)
+  : native(std::move(native)), state(std::move(state)) {
+#ifdef __GLIBC__
+  auto* engine = getExecutionEngine();
+  // These glibc functions come from libc_nonshared.a and cannot be found by
+  // dlsym. The jank session lives until process exit, so registered JIT handlers
+  // remain callable for quick_exit and fork. LLJIT handles atexit itself.
+  llvm::orc::SymbolMap symbols;
+  for(auto [name, address] : {
+      std::pair{"at_quick_exit", reinterpret_cast<void*>(&::at_quick_exit)},
+      std::pair{"pthread_atfork", reinterpret_cast<void*>(&::pthread_atfork)},
+      std::pair{"__stack_chk_fail_local", reinterpret_cast<void*>(&::__stack_chk_fail_local)}}) {
+    symbols[engine->mangleAndIntern(name)] = {
+      llvm::orc::ExecutorAddr::fromPtr(address),
+      llvm::JITSymbolFlags::Exported | llvm::JITSymbolFlags::Callable};
+  }
+  llvm::cantFail(engine->getProcessSymbolsJITDylib()->define(
+    llvm::orc::absoluteSymbols(std::move(symbols))));
+#endif
+}
+clang_interpreter::~clang_interpreter() = default;
+llvm::orc::LLJIT* clang_interpreter::getExecutionEngine() {
+  llvm::cantFail(native->getExecutionEngine());
+  assert(state->engine && "Clang must construct the supplied JIT builder");
+  return state->engine;
+}
+llvm::Error clang_interpreter::Execute(clang::PartialTranslationUnit& unit) {
+  if(unit.TheModule) {
+    bindProcessWeakGlobals(*unit.TheModule);
+    dedupeWeakEmulatedTLS(*unit.TheModule, defined_tls);
+  }
+  return native->Execute(unit);
+}
+llvm::Error clang_interpreter::ParseAndExecute(llvm::StringRef code, clang::Value* value) {
+  if(value) return native->ParseAndExecute(code, value);
+  auto unit = Parse(code);
+  if(!unit) return unit.takeError();
+  if(unit->TheModule) return Execute(*unit);
+  return llvm::Error::success();
+}
+void* clang_interpreter::getAddressOfGlobal(clang::GlobalDecl decl) {
+  auto address = native->getSymbolAddress(decl);
+  if(!address) { llvm::consumeError(address.takeError()); return nullptr; }
+  return address->toPtr<void*>();
+}
