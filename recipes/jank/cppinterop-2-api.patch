+
+TCppScope_t GetScopeFromCompleteName(const std::string& name) {
+  std::string delim = "::";
+  size_t start = 0;
+  size_t end = name.find(delim);
+  TCppScope_t curr_scope = 0;
+  while (end != std::string::npos) {
+    curr_scope = GetScope(name.substr(start, end - start), curr_scope);
+    start = end + delim.length();
+    end = name.find(delim, start);
+  }
+  return GetScope(name.substr(start, end), curr_scope);
+}
+
+void GetStaticDatamembers(TCppScope_t scope,
+                          std::vector<TCppScope_t>& datamembers) {
+  auto* record = llvm::dyn_cast_or_null<CXXRecordDecl>(static_cast<Decl*>(scope));
+  if(!record || !IsComplete(scope)) return;
+  record = record->getDefinition();
+  getSema().ForceDeclarationOfImplicitMembers(record);
+  for(auto* decl : record->decls()) {
+    if(llvm::isa<VarDecl>(decl)) datamembers.push_back(decl);
+    else if(auto* shadow = llvm::dyn_cast<UsingShadowDecl>(decl))
+      if(llvm::isa<VarDecl>(shadow->getTargetDecl())) datamembers.push_back(shadow);
+  }
+}
