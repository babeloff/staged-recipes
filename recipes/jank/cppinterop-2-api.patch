+class DiagnosticTextConsumer final : public DiagnosticConsumer {
+public:
+  void HandleDiagnostic(DiagnosticsEngine::Level Level,
+                        const Diagnostic& Info) override {
+    if (Level != DiagnosticsEngine::Note)
+      return;
+    SmallString<256> Message;
+    Info.FormatDiagnostic(Message);
+    if (Message.empty())
+      return;
+    if (!Text.empty())
+      Text += " ";
+    Text.append(Message.begin(), Message.end());
+  }
+
+  std::string Text;
+};
+class DiagnosticClientRAII {
+private:
+  DiagnosticsEngine& Diags;
+  DiagnosticConsumer* OldClient;
+  std::unique_ptr<DiagnosticConsumer> OldOwner;
+  bool OldSuppressAllDiagnostics;
+  bool OldLastDiagnosticIgnored;
+
+public:
+  explicit DiagnosticClientRAII(DiagnosticsEngine& Diags)
+      : Diags(Diags), OldClient(Diags.getClient()),
+        OldOwner(Diags.takeClient()),
+        OldSuppressAllDiagnostics(Diags.getSuppressAllDiagnostics()),
+        OldLastDiagnosticIgnored(Diags.isLastDiagnosticIgnored()) {
+    Diags.setClient(&Consumer, false);
+    Diags.setSuppressAllDiagnostics(false);
+    Diags.setLastDiagnosticIgnored(false);
+  }
+
+  ~DiagnosticClientRAII() {
+    if (OldOwner) {
+      auto* Client = OldOwner.release();
+      Diags.setClient(Client, true);
+    } else {
+      Diags.setClient(OldClient, false);
+    }
+    Diags.setSuppressAllDiagnostics(OldSuppressAllDiagnostics);
+    Diags.setLastDiagnosticIgnored(OldLastDiagnosticIgnored);
+  }
+
+  DiagnosticTextConsumer Consumer;
+};
+static void ForceCodeGen(Decl* D, jank::jit::clang_interpreter& I) {
+  // The decl was deferred by CodeGen. Force its emission.
+  // FIXME: In ASTContext::DeclMustBeEmitted we should check if the
+  // Decl::isUsed is set or we should be able to access CodeGen's
+  // addCompilerUsedGlobal.
+  ASTContext& C = I.getSema().getASTContext();
+
+  D->addAttr(UsedAttr::CreateImplicit(C));
+#ifdef CPPINTEROP_USE_CLING
+  cling::Interpreter::PushTransactionRAII RAII(&I);
+  I.getCI()->getASTConsumer().HandleTopLevelDecl(DeclGroupRef(D));
+#else // CLANG_REPL
+  I.getCI()->getASTConsumer().HandleTopLevelDecl(DeclGroupRef(D));
+  // Take the newest llvm::Module produced by CodeGen and send it to JIT.
+  auto GeneratedPTU = I.Parse("");
+  if (!GeneratedPTU)
+    llvm::logAllUnhandledErrors(GeneratedPTU.takeError(), llvm::errs(),
+                                "[ForceCodeGen] Failed to generate PTU:");
+
+  // From cling's BackendPasses.cpp
+  // FIXME: We need to upstream this code in IncrementalExecutor::addModule
+  for (auto& GV : GeneratedPTU->TheModule->globals()) {
+    llvm::GlobalValue::LinkageTypes LT = GV.getLinkage();
+    if (GV.isDeclaration() || !GV.hasName() ||
+        GV.getName().starts_with(".str") ||
+        !llvm::GlobalVariable::isDiscardableIfUnused(LT) ||
+        LT != llvm::GlobalValue::InternalLinkage)
+      continue; // nothing to do
+    GV.setLinkage(llvm::GlobalValue::WeakAnyLinkage);
+  }
+  if (auto Err = I.Execute(*GeneratedPTU))
+    llvm::logAllUnhandledErrors(std::move(Err), llvm::errs(),
+                                "[ForceCodeGen] Failed to execute PTU:");
+#endif
+}
