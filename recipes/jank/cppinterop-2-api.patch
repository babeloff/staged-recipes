+#pragma once
+
+#include <memory>
+#include <clang/AST/GlobalDecl.h>
+#include <clang/Frontend/CompilerInstance.h>
+#include <clang/Interpreter/Interpreter.h>
+#include <clang/Interpreter/Value.h>
+#include <clang/Sema/Sema.h>
+#include <llvm/ADT/StringSet.h>
+#include <llvm/ExecutionEngine/Orc/LLJIT.h>
+#include <llvm/IR/Module.h>
+
+namespace jank::jit
+{
+  // Own the native session. CppInterOp's public reflection handles refer to
+  // this session's AST; no CppInterOp interpreter implementation is accessed.
+  class clang_interpreter
+  {
+  public:
+    struct jit_state { llvm::orc::LLJIT* engine{}; };
+    clang_interpreter(std::unique_ptr<clang::Interpreter> native,
+                      std::shared_ptr<jit_state> state);
+    ~clang_interpreter();
+    clang::CompilerInstance const* getCI() const { return native->getCompilerInstance(); }
+    clang::CompilerInstance* getCI() { return native->getCompilerInstance(); }
+    clang::CompilerInstance* getCompilerInstance() { return getCI(); }
+    clang::Sema& getSema() { return getCI()->getSema(); }
+    llvm::orc::LLJIT* getExecutionEngine();
+    auto Parse(llvm::StringRef code) { return native->Parse(code); }
+    llvm::Error Execute(clang::PartialTranslationUnit& unit);
+    llvm::Error ParseAndExecute(llvm::StringRef code, clang::Value* value = nullptr);
+    auto getSymbolAddress(llvm::StringRef name) { return native->getSymbolAddress(name); }
+    auto getSymbolAddress(clang::GlobalDecl decl) { return native->getSymbolAddress(decl); }
+    void* getAddressOfGlobal(clang::GlobalDecl decl);
+    operator clang::Interpreter&() { return *native; }
+  private:
+    std::unique_ptr<clang::Interpreter> native;
+    std::shared_ptr<jit_state> state;
+    llvm::StringSet<> defined_tls;
+  };
+}
