+TCppType_t GetTypeFromScope(TCppScope_t klass) {
+  if (!klass)
+    return 0;
+
+  auto* D = (Decl*)klass;
+  auto& C = getASTContext();
+
+  if (auto* FTD = dyn_cast<FunctionTemplateDecl>(D)) {
+    FunctionDecl* FD = FTD->getTemplatedDecl();
+    if (FD) {
+      return C.getPointerType(FD->getType()).getAsOpaquePtr();
+    }
+    return 0;
+  }
+  if (auto* FD = dyn_cast<FunctionDecl>(D)) {
+    return C.getPointerType(FD->getType()).getAsOpaquePtr();
+  }
+  if (ValueDecl* VD = dyn_cast<ValueDecl>(D))
+    return VD->getType().getAsOpaquePtr();
+  if (auto* CTD = dyn_cast<ClassTemplateDecl>(D)) {
+    CXXRecordDecl* RD = CTD->getTemplatedDecl();
+    if (RD) {
+      return C.getCanonicalTagType(RD).getAsOpaquePtr();
+    }
+    return 0;
+  }
+
+  if (auto* TD = dyn_cast<TypeDecl>(D))
+    return getASTContext().getTypeDeclType(TD).getAsOpaquePtr();
+
+  return (TCppType_t) nullptr;
+}
