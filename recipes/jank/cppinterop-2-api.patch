+std::vector<TCppFunction_t> GetFunctionsUsingName(TCppScope_t scope,
+                                                   const std::string& name) {
+  auto* D = (Decl*)scope;
+
+  if (!scope || name.empty())
+    return {};
+
+  D = GetUnderlyingScope(D);
+
+  // Not every Decl doubles as a DeclContext (e.g. VarDecl, FieldDecl,
+  // EnumConstantDecl). Only DeclContext-capable decls can be looked into.
+  if (!D || !llvm::isa<DeclContext>(D))
+    return {};
+
+  std::vector<TCppFunction_t> funcs;
+  llvm::StringRef Name(name);
+  auto& S = getSema();
+  DeclarationName DName = &getASTContext().Idents.get(name);
+  clang::LookupResult R(S, DName, SourceLocation(), Sema::LookupOrdinaryName,
+                        RedeclarationKind::ForVisibleRedeclaration);
+
+  lookupNamed(S, R, Decl::castToDeclContext(D));
+
+  if (R.empty())
+    return funcs;
+
+  R.resolveKind();
+
+  for (auto* Found : R)
+    if (llvm::isa<FunctionDecl>(Found) ||
+        llvm::isa<FunctionTemplateDecl>(Found))
+      funcs.push_back(Found);
+
+  return funcs;
+}
