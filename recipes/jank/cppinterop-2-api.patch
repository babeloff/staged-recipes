+TCppScope_t LookupDatamember(const std::string& name, TCppScope_t parent) {
+  return Cpp::LookupDatamember(name, Cpp::ConstDeclRef(parent)) .data;
+}
+// Clang setup owned by jank: upstream's public constructor cannot supply an
+// embedded PCH filesystem, a code model, or stale-PCH diagnostics.
+namespace {
+// Match CppInterOp 2.0.0's LLVM-23 lifetime policy: LLVM's late static
+// destruction cannot safely tear down a JIT. Explicit deletion remains
+// available for tests and hosts that shut down before their LLVM globals.
+llvm::ManagedStatic<std::unique_ptr<compat::Interpreter>> owned_interpreter;
+
+class PCHStalenessDiagnosticConsumer final : public clang::DiagnosticConsumer {
+  clang::DiagnosticConsumer &target;
+  bool &out_of_date;
+public:
+  PCHStalenessDiagnosticConsumer(clang::DiagnosticConsumer &target, bool &out_of_date)
+    : target(target), out_of_date(out_of_date) {}
+  void BeginSourceFile(clang::LangOptions const &opts, clang::Preprocessor const *pp = nullptr) override {
+    target.BeginSourceFile(opts, pp);
+  }
+  void EndSourceFile() override { target.EndSourceFile(); }
+  bool IncludeInDiagnosticCounts() const override { return target.IncludeInDiagnosticCounts(); }
+  void HandleDiagnostic(clang::DiagnosticsEngine::Level level, clang::Diagnostic const &info) override {
+    if(info.getID() == clang::diag::err_fe_ast_file_modified
+       || info.getID() == clang::diag::note_fe_ast_file_modified) out_of_date = true;
+    if(out_of_date) return;
+    clang::DiagnosticConsumer::HandleDiagnostic(level, info);
+    target.HandleDiagnostic(level, info);
+  }
+};
+}
+
+TInterp_t CreateInterpreter(std::vector<char const*> const &args,
+                           std::vector<char const*> const &gpu_args,
+                           std::map<char const*, std::string_view> const &vfs,
+                           std::optional<int> const &cm, bool *pch_out_of_date) {
+  if(pch_out_of_date) *pch_out_of_date = false;
+  if(!gpu_args.empty()) {
+    llvm::errs() << "jank's interpreter adapter does not support GPU arguments\n";
+    return nullptr;
+  }
+  // Initialize CppInterOp's targets before constructing the Clang interpreter.
+  if(Cpp::GetInterpreter()) {
+    llvm::errs() << "jank's interpreter is already initialized\n";
+    return nullptr;
+  }
+  clang::IncrementalCompilerBuilder builder;
+  builder.SetCompilerArgs(args);
+  auto ci = builder.CreateCpp();
+  if(!ci) {
+    llvm::logAllUnhandledErrors(ci.takeError(), llvm::errs(), "Cannot create jank compiler: ");
+    return nullptr;
+  }
+  (*ci)->LoadRequestedPlugins();
+  auto overlay = llvm::makeIntrusiveRefCnt<llvm::vfs::OverlayFileSystem>(llvm::vfs::getRealFileSystem());
+  auto memory = llvm::makeIntrusiveRefCnt<llvm::vfs::InMemoryFileSystem>();
+  for(auto const &[path, contents] : vfs) {
+    memory->addFile(path, 0, llvm::MemoryBuffer::getMemBuffer(
+      llvm::StringRef(contents.data(), contents.size()), path, false));
+  }
+  overlay->pushOverlay(memory);
+  (*ci)->createVirtualFileSystem(overlay);
+
+  // Keep the original client alive and restore it before returning: the caller's
+  // stale-PCH flag does not outlive this initialization attempt.
+  auto &diagnostics = (*ci)->getDiagnostics();
+  auto diagnostic_owner = diagnostics.takeClient();
+  auto *diagnostic_client = diagnostics.getClient();
+  bool stale{};
+  PCHStalenessDiagnosticConsumer consumer{*diagnostic_client, stale};
+  diagnostics.setClient(&consumer, false);
+  auto executor = std::make_unique<clang::IncrementalExecutorBuilder>();
+  if(cm) executor->CM = static_cast<llvm::CodeModel::Model>(*cm);
+  auto inner = clang::Interpreter::create(std::move(*ci), std::move(executor));
+  if(inner) {
+    if(diagnostic_owner) diagnostics.setClient(diagnostic_owner.release(), true);
+    else diagnostics.setClient(diagnostic_client, false);
+  }
+  if(pch_out_of_date) *pch_out_of_date = stale;
+  if(stale || !inner) {
+    if(!inner) {
+      if(stale) llvm::consumeError(inner.takeError());
+      else llvm::logAllUnhandledErrors(inner.takeError(), llvm::errs(), "Cannot create jank interpreter: ");
+    }
+    return nullptr;
+  }
+
+#ifdef __GLIBC__
+  CppInternal::installGlibcNonsharedSupport(*compat::getExecutionEngine(**inner), inner->get());
+#endif
+  *owned_interpreter = std::make_unique<compat::Interpreter>(std::move(*inner));
+  Cpp::UseExternalInterpreter(Cpp::InterpRef(owned_interpreter->get()));
+  auto *engine = (*owned_interpreter)->getExecutionEngine();
+  // These helpers are exported by the packaged library and are required by
+  // clang::Interpreter's expression-value lowering.
+  for(auto name : {"__ci_newtag", "__clang_Interpreter_SetValueWithAlloc", "__clang_Interpreter_SetValueNoAlloc"}) {
+    auto *address = llvm::sys::DynamicLibrary::SearchForAddressOfSymbol(name);
+    if(!address) llvm::report_fatal_error(llvm::Twine("Missing CppInterOp runtime helper: ") + name);
+    llvm::cantFail(engine->getProcessSymbolsJITDylib()->define(llvm::orc::absoluteSymbols({
+      {engine->mangleAndIntern(name), {llvm::orc::ExecutorAddr::fromPtr(address), llvm::JITSymbolFlags::Exported}}
+    })));
+  }
+  if(auto err = (*owned_interpreter)->ParseAndExecute(R"(
+    namespace __internal_CppInterOp {
+      template <typename Signature> struct function;
+      template <typename Res, typename... Args> struct function<Res(Args...)> { typedef Res result_type; };
+    }
+  )")) llvm::logAllUnhandledErrors(std::move(err), llvm::errs(), "Cannot initialize CppInterOp helpers: ");
+  return owned_interpreter->get();
+}
+
+bool DeleteInterpreter(TInterp_t interpreter) {
+  if(interpreter && interpreter != owned_interpreter->get()) return false;
+  if(!*owned_interpreter) return false;
+  Cpp::DeleteInterpreter(Cpp::InterpRef(owned_interpreter->get()));
+  owned_interpreter->reset();
+  return true;
+}
