+static clang::Sema& getSema() { return getInterp().getCI()->getSema(); }
+static clang::ASTContext& getASTContext() { return getSema().getASTContext(); }
+// Resolve names in the same native Clang session that owns jank's AST.
+static void lookupNamed(Sema& S, LookupResult& R, DeclContext* within) {
+  R.suppressDiagnostics();
+  if(within) {
+    if(auto* tag = llvm::dyn_cast<TagDecl>(within)) {
+      within = llvm::dyn_cast_or_null<DeclContext>(tag->getDefinition());
+      if(!within) return;
+    } else within = within->getPrimaryContext();
+    S.LookupQualifiedName(R, within);
+  } else S.LookupName(R, S.TUScope);
+}
+static NamedDecl* lookupNamed(std::string const& name, DeclContext* within) {
+  auto& S = getSema();
+  LookupResult result(S, &getASTContext().Idents.get(name), SourceLocation(), Sema::LookupOrdinaryName);
+  lookupNamed(S, result, within);
+  result.resolveKind();
+  if(!result.isSingleResult()) return nullptr;
+  return result.getFoundDecl();
+}
