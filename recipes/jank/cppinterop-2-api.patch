+TEST_SUITE("analyze/upstream_cppinterop")
+{
+  using namespace jank::analyze;
+
+  TEST_CASE("non-reference types and arrays preserve the facade contract")
+  {
+    auto const integer{ cpp_util::int_type() };
+    DOCTEST_CHECK(cppinterop::get_non_reference_type(integer) == integer);
+    auto const array{ cppinterop::get_array_type(integer, 4) };
+    DOCTEST_CHECK(cppinterop::get_array_size(array) == 4);
+    DOCTEST_CHECK(cppinterop::get_pointee_type(array) == integer);
+  }
+
+  TEST_CASE("function templates and qualified constructors remain discoverable")
+  {
+    jank::runtime::__rt_ctx->eval_cpp_string(R"cpp(
+      namespace jank::test::upstream_cppinterop {
+        template<class T> T identity(T x) { return x; }
+        struct widget {
+          template<class T> widget(T const&) {}
+        };
+        int choose(int);
+        int choose(double);
+      }
+    )cpp").expect_ok();
+    auto const scope{ cppinterop::get_scope_from_complete_name("jank::test::upstream_cppinterop") };
+    REQUIRE(scope);
+    auto const templates{ cppinterop::get_functions_using_name(scope, "identity") };
+    REQUIRE(templates.size() == 1);
+    DOCTEST_CHECK(cppinterop::is_templated_function(templates.front()));
+    auto const integer{ cpp_util::int_type() };
+    jank_cpp::TemplateArgInfo const argument{ integer };
+    auto const instance{ cppinterop::instantiate_template(templates.front(), &argument, 1, true) };
+    REQUIRE(instance);
+    DOCTEST_CHECK(cppinterop::get_canonical_type(cppinterop::get_function_return_type(instance))
+          == cppinterop::get_canonical_type(integer));
+    auto const widget{ cppinterop::get_named("widget", scope) };
+    REQUIRE(widget);
+    std::vector<cppinterop::clang_decl> constructors;
+    cppinterop::lookup_constructors("jank::test::upstream_cppinterop::widget", widget, constructors);
+    REQUIRE(!constructors.empty());
+    auto const functions{ cppinterop::get_functions_using_name(scope, "choose") };
+    REQUIRE(functions.size() == 2);
+    auto const best{ cppinterop::best_overload_match(functions, { integer }, {}) };
+    REQUIRE(best.size() == 1);
+    auto const info{ cppinterop::get_overload_candidate_info(best.front(), { integer }, {}) };
+    DOCTEST_CHECK(info.m_Viable);
+    REQUIRE(info.m_Arguments.size() == 1);
+    DOCTEST_CHECK(info.m_Arguments.front().m_Conversion == jank_cpp::OverloadCandidateConversion::None);
+  }
