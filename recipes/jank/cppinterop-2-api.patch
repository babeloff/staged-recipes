+  for (auto value : values) result.emplace_back(value);
+  return result;
+}
+template <class Ref> std::vector<void*> unbox(std::vector<Ref> const& values) {
+  std::vector<void*> result;
+  result.reserve(values.size());
+  for (auto value : values) result.emplace_back(value.data);
+  return result;
+}
